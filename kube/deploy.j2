apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{ zordbase_app_name }}"
  namespace: "{{ app_namespace | default('default') }}"
  labels:
    app: "{{ zordbase_app_name }}"
spec:
  replicas: {{ zordbase_app_replicas | default(1) }}
  selector:
    matchLabels:
      app: "{{ zordbase_app_name }}"
  template:
    metadata:
      labels:
        app: "{{ zordbase_app_name }}"
    spec:
      containers:
      - name: "{{ zordbase_app_name }}"
        image: "{{ zordbase_app_image }}"
        imagePullPolicy: Never
        ports:
        - containerPort: {{ zordbase_container_port | default(80) }}
---
apiVersion: v1
kind: Service
metadata:
  name: "{{ zordbase_app_name }}-svc"
  namespace: "{{ zordbase_app_namespace | default('default') }}"
spec:
  type: ClusterIP
  selector:
    app: "{{ zordbase_app_name }}"
  ports:
  - port: {{ zordbase_service_port | default(80) }}
    targetPort: {{ zordbase_container_port | default(80) }}
---
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: "{{ zordbase_app_name }}-ingress"
  namespace: "{{ zordbase_app_namespace | default('default') }}"
spec:
  rules:
  - host: "{{ zordbase_app_host }}"
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: "{{ zordbase_app_name }}-svc"
            port:
              number: "{{ zordbase_service_port | default(80) }}"

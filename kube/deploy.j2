apiVersion: apps/v1
kind: Deployment
metadata:
  name: "{{ zordbase_app_name }}"
  namespace: "{{ zordbase_app_namespace | default('default') }}"
  labels:
    app: "{{ zordbase_app_name }}"
spec:
  replicas: {{ zordbase_app_replicas | default(1) }}
  selector:
    matchLabels:
      app: "{{ zordbase_app_name }}"
  template:
    metadata:
      labels:
        app: "{{ zordbase_app_name }}"
    spec:
      containers:
      - name: "{{ zordbase_app_name }}"
        image: "{{ zordbase_app_image }}"
        imagePullPolicy: Never
        ports:
        - containerPort: {{ zordbase_container_port | default(3000) }}
---
apiVersion: v1
kind: Service
metadata:
  name: "{{ zordbase_app_name }}-svc"
  namespace: "{{ zordbase_app_namespace | default('default') }}"
spec:
  type: ClusterIP
  selector:
    app: "{{ zordbase_app_name }}"
  ports:
  - port: {{ zordbase_service_port | default(80) }}
    targetPort: {{ zordbase_container_port | default(3000) }}
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: "{{ zordbase_app_name }}-ingress"
  namespace: "{{ zordbase_app_namespace | default('default') }}"
spec:
  entryPoints:
    - websecure
  routes:
    - match: Host(`{{ zordbase_app_host }}`)
      kind: Rule
      services:
        - name: "{{ zordbase_app_name }}-svc"
          port: {{ zordbase_service_port | default(80) | int }}
  tls:
    secretName: "{{ zordbase_app_name }}-tls"
---
apiVersion: traefik.io/v1alpha1
kind: IngressRoute
metadata:
  name: "{{ zordbase_app_name }}-ingress-http"
  namespace: "{{ zordbase_app_namespace | default('default') }}"
spec:
  entryPoints:
    - web
  routes:
    - match: Host(`{{ zordbase_app_host }}`)
      kind: Rule
      middlewares:
        - name: "{{ zordbase_app_name }}-https-redirect"
      services:
        - name: "{{ zordbase_app_name }}-svc"
          port: {{ zordbase_service_port | default(80) | int }}
